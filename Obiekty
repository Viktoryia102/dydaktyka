// Zadanie 16: Klasa Osoba
class Osoba {
    constructor(imie, wiek) {
        this.imie = imie;
        this._wiek = wiek; // prywatne z getterem/setterem
    }
    
    // Zadanie 16: metoda przywitaj()
    przywitaj() {
        return `Cześć, mam na imię ${this.imie}`;
    }
    
    // Zadanie 19: Getter i setter dla wieku
    get wiek() {
        return this._wiek;
    }
    
    set wiek(value) {
        if (value < 0) {
            console.error('Błąd: Wiek nie może być mniejszy niż 0!');
        } else {
            this._wiek = value;
        }
    }
}

// Zadanie 17: Klasa Nauczyciel dziedzicząca po Osoba
class Nauczyciel extends Osoba {
    constructor(imie, wiek, przedmiot) {
        super(imie, wiek);
        this.przedmiot = przedmiot;
        this.#pensja = 0; // Zadanie 20: prywatne pole
    }
    
    // Zadanie 18: Nadpisanie metody przywitaj()
    przywitaj() {
        return `Dzień dobry, jestem nauczycielem ${this.imie}, uczę ${this.przedmiot}`;
    }
    
    // Zadanie 20: Prywatne pole #pensja
    #pensja;
    
    ustawPensje(kwota) {
        this.#pensja = kwota;
    }
    
    pokazPensje() {
        return this.#pensja;
    }
}

console.log('=== ZADANIE 16-20: Dziedziczenie i enkapsulacja ===');
const osoba = new Osoba('Marek', 30);
console.log(osoba.przywitaj());

const nauczyciel = new Nauczyciel('Anna', 35, 'matematyki');
