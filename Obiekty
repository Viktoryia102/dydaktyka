Ниже готовый код на JavaScript (без POZIOM 5), выполняющий все задания с 1 по 20.
Każdy poziom jest opisany komentarzem w kodzie.

```html
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title>Zadania - programowanie obiektowe</title>
</head>
<body>
    <div id="produkty"></div>

    <script>
        // ========== POZIOM 1 ==========
        console.log('===== POZIOM 1 =====');

        // 1. Utwórz obiekt książka
        const ksiazka = {
            tytul: 'Wiedźmin',
            autor: 'Andrzej Sapkowski',
            rokWydania: 1993
        };

        // 2. Wypisz wszystkie właściwości w konsoli
        console.log('Właściwości książki:', ksiazka);

        // 3. Dodaj metodę opis()
        ksiazka.opis = function() {
            return `Tytuł: ${this.tytul} Autor: ${this.autor}`;
        };
        console.log(ksiazka.opis());

        // 4. Zmień jedną właściwość i sprawdź
        ksiazka.rokWydania = 1994;
        console.log('Po zmianie rokWydania:', ksiazka);

        // 5. Sprawdź:
        console.log('Czy obiekt ma właściwość "wydawnictwo"?', ksiazka.hasOwnProperty('wydawnictwo'));
        console.log('Ilość właściwości:', Object.keys(ksiazka).length);

        // 6. Tablica 3 obiektów produkt
        const produkty = [
            { nazwa: 'Mleko', cena: 3.50 },
            { nazwa: 'Chleb', cena: 4.20 },
            { nazwa: 'Masło', cena: 7.90 }
        ];
        console.log('Nazwy produktów:');
        produkty.forEach(p => console.log(p.nazwa));

        // ========== POZIOM 2 - FUNKCJA KONSTRUKTOR ==========
        console.log('===== POZIOM 2 - FUNKCJA KONSTRUKTOR =====');

        // 6. Funkcja konstruktor Uczen
        function Uczen(imie, nazwisko, klasa) {
            this.imie = imie;
            this.nazwisko = nazwisko;
            this.klasa = klasa;
        }

        // 7. Dodaj metodę przedstawSie()
        Uczen.prototype.przedstawSie = function() {
            return `Nazywam się ${this.imie} ${this.nazwisko} i chodzę do klasy ${this.klasa}`;
        };

        // 8. Utwórz 3 uczniów
        const uczen1 = new Uczen('Jan', 'Kowalski', '3A');
        const uczen2 = new Uczen('Anna', 'Nowak', '2B');
        const uczen3 = new Uczen('Piotr', 'Wiśniewski', '1C');

        console.log(uczen1.przedstawSie());
        console.log(uczen2.przedstawSie());
        console.log(uczen3.przedstawSie());

        // 10. Dodaj metodę zwracającą inicjały
        Uczen.prototype.inicjaly = function() {
            return `${this.imie[0]}.${this.nazwisko[0]}.`;
        };
        console.log('Inicjały ucznia 1:', uczen1.inicjaly());

        // ========== POZIOM 3 - CLASS ==========
        console.log('===== POZIOM 3 - CLASS =====');

        // 9. Przepisz zadania 6-8 używając class
        class UczenClass {
            constructor(imie, nazwisko, klasa) {
                this.imie = imie;
                this.nazwisko = nazwisko;
                this.klasa = klasa;
            }

            przedstawSie() {
                return `Nazywam się ${this.imie} ${this.nazwisko} i chodzę do klasy ${this.klasa}`;
            }

            inicjaly() {
                return `${this.imie[0]}.${this.nazwisko[0]}.`;
            }
        }

        const uczenClass1 = new UczenClass('Ewa', 'Wiśniewska', '3B');
        console.log(uczenClass1.przedstawSie());
        console.log(uczenClass1.inicjaly());

        // 11. Klasa Produkt
        class Produkt {
            constructor(nazwa, cena) {
                this.nazwa = nazwa;
                this.cena = cena;
            }

            // 12. Metoda render() - dodaje element do dokumentu
            render() {
                const div = document.createElement('div');
                div.className = 'produkt';
                div.dataset.nazwa = this.nazwa;
                div.innerHTML = `
                    <span>${this.nazwa} - ${this.cena.toFixed(2)} zł</span>
                    <button class="usun">Usuń</button>
                    <button class="promocja">Promocja -20%</button>
                `;

                // 14. Obsługa przycisku Usuń
                div.querySelector('.usun').addEventListener('click', () => {
                    div.remove();
                });

                // 15. Obsługa przycisku Promocja
                div.querySelector('.promocja').addEventListener('click', () => {
                    this.cena *= 0.8; // -20%
                    this.aktualizujWidok(div);
                });

                return div;
            }

            // Pomocnicza metoda do aktualizacji widoku po promocji
            aktualizujWidok(div) {
                const span = div.querySelector('span');
                span.textContent = `${this.nazwa} - ${this.cena.toFixed(2)} zł`;
            }
        }

        // 13. Tablica 4 produktów i wygenerowanie na stronie
        const produktyLista = [
            new Produkt('Jabłka', 2.99),
            new Produkt('Gruszki', 3.49),
            new Produkt('Banany', 4.99),
            new Produkt('Pomarańcze', 5.29)
        ];

        const kontener = document.getElementById('produkty');
        produktyLista.forEach(produkt => {
            kontener.appendChild(produkt.render());
        });

        // ========== POZIOM 4 – DZIEDZICZENIE I ENKAPSULACJA ==========
        console.log('===== POZIOM 4 =====');

        // 16. Klasa Osoba
        class Osoba {
            constructor(imie, wiek) {
                this.imie = imie;
                this.wiek = wiek;
            }

            przywitaj() {
                return `Cześć, jestem ${this.imie}.`;
            }
        }

        // 17. Klasa Nauczyciel dziedziczy po Osoba
        class Nauczyciel extends Osoba {
            // 20. Prywatne pole #pensja
            #pensja;

            constructor(imie, wiek, przedmiot, pensja) {
                super(imie, wiek);
                this.przedmiot = przedmiot;
                this.#pensja = pensja;
            }

            // 18. Nadpisanie metody przywitaj()
            przywitaj() {
                return `Dzień dobry, jestem nauczycielką/em ${this.imie}, uczę ${this.przedmiot}.`;
            }

            // 19. Getter i setter dla wieku
            get wiek() {
                return this._wiek;
            }

            set wiek(value) {
                if (value < 0) {
                    console.error('Wiek nie może być ujemny!');
                } else {
                    this._wiek = value;
                }
            }

            // Getter dla pensji (bo pole prywatne)
            getPensja() {
                return this.#pensja;
            }
        }

        // Test klasy Nauczyciel
        const nauczyciel = new Nauczyciel('Maria', 35, 'matematyki', 5000);
        console.log(nauczyciel.przywitaj());
        console.log('Pensja:', nauczyciel.getPensja());

        // Test settera wieku
        nauczyciel.wiek = -5; // błąd
        nauczyciel.wiek = 40; // poprawnie
        console.log('Wiek nauczyciela:', nauczyciel.wiek);
    </script>
</body>
</html>
```

Kod zawiera:

· POZIOM 1: obiekt ksiazka, modyfikacje, sprawdzanie właściwości, tablica produktów
· POZIOM 2: funkcja konstruktor Uczen z metodami
· POZIOM 3: klasa UczenClass, klasa Produkt z renderowaniem i przyciskami (Usuń, Promocja -20%)
· POZIOM 4: klasy Osoba, Nauczyciel (dziedziczenie), nadpisywanie metod, getter/setter dla wieku, prywatne pole #pensja

