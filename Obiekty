// Zadanie 11: Klasa Produkt
class Produkt {
    constructor(nazwa, cena) {
        this.nazwa = nazwa;
        this.cena = cena;
    }
    
    // Zadanie 12: metoda render() - wersja konsolowa
    render() {
        console.log(`Produkt: ${this.nazwa}, Cena: ${this.cena} zł`);
        return `<div>${this.nazwa} - ${this.cena} zł</div>`;
    }
    
    // Metoda do aktualizacji ceny
    promocja(procent) {
        this.cena = this.cena * (1 - procent/100);
    }
}

// Zadanie 13: Tablica 4 produktów
const produkty2 = [
    new Produkt('Jabłka', 2.50),
    new Produkt('Gruszki', 3.20),
    new Produkt('Banany', 4.10),
    new Produkt('Pomarańcze', 5.30)
];

console.log('=== ZADANIE 13: Lista produktów ===');
produkty2.forEach(p => p.render());

// Zadanie 14-15: Symulacja w konsoli
console.log('=== ZADANIE 14-15: Operacje na produktach ===');
console.log('Usuwam produkt "Jabłka" (symulacja)');
const produktyPoUsunieciu = produkty2.filter(p => p.nazwa !== 'Jabłka');
console.log('Pozostałe produkty:', produktyPoUsunieciu.map(p => p.nazwa));

console.log('Promocja -20% na "Banany"');
const produktPromocja = produkty2.find(p => p.nazwa === 'Banany');
if (produktPromocja) {
    console.log('Cena przed promocją:', produktPromocja.cena);
    produktPromocja.promocja(20);
    console.log('Cena po promocji:', produktPromocja.cena);
}

